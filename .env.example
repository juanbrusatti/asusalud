# ---------------------------------------------------------------------------
# Dlay Agenda · variables de entorno
# Copiá este archivo a .env.local y completalo. Ver docs/variables-de-entorno.md
# ---------------------------------------------------------------------------

# Supabase. En local salen de `npm run db:start`; en producción, del panel del
# proyecto (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# La clave pública. Los proyectos nuevos la muestran como «publishable»
# (sb_publishable_…) y los viejos como «anon» (un JWT). Sirven las dos: si
# están las dos, gana la publishable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio. En Vercel se completa con la del deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave con permisos totales: SE SALTEA TODA LA RLS.
# Sólo en el servidor y sólo para tareas del sistema (colas, webhooks,
# importaciones). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Clave pública de las notificaciones push. Es pública por diseño: el navegador
# la necesita para suscribirse. La privada va en las Edge Functions.
# Se genera con: node scripts/vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sólo para la suite de pruebas de aislamiento, que habla directo con Postgres.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Cobro de la cuenta de Dlay
# ---------------------------------------------------------------------------
# La clave de producción de la aplicación de Mercado Pago DE DLAY, no la del
# negocio: los cobros van a nuestra cuenta. Se saca de
# mercadopago.com.ar/developers → Tus integraciones → tu aplicación →
# Credenciales de producción → Access Token.
#
# Sin esto el sistema funciona igual: lo único que no anda es el botón de
# pagar dentro de «Tu cuenta», y la pantalla lo avisa.
MERCADOPAGO_ACCESS_TOKEN=
